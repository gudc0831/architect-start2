# Select the backend mode for this environment.
# local: local JSON data + local uploads + auth stub
# firestore: Firestore metadata + local uploads + auth stub
# cloud: Supabase Auth + Postgres + Supabase Storage
APP_BACKEND_MODE=local

# Data guard policy
# strict: block risky writes unless DATA_GUARD_CONFIRM matches the active lock token
# warn: log the warning and allow the write to continue
DATA_GUARD_MODE=strict
DATA_GUARD_CONFIRM=

# Local-first development defaults
# Set LOCAL_DATA_ROOT to writable persistent storage in deployed Node environments
# if you want the holiday cache to survive restarts and scale-out.
LOCAL_DATA_ROOT=D:\architect-start-data
LOCAL_UPLOAD_ROOT=D:\architect-start-data\uploads
LOCAL_PROJECT_META_PATH=D:\architect-start-data\project\project-meta.json
DEFAULT_PROJECT_NAME=Architect Start
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=pdf,dwg,dxf,xlsx,xls,doc,docx,ppt,pptx,png,jpg,jpeg,webp,txt,csv,zip
HOLIDAY_API_SERVICE_KEY=

# Cloud backend only
DATABASE_URL=
# Defaults to 3 when unset. Keep modest for Supabase pooler; raise only after checking DB limits.
DATABASE_POOL_MAX=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=task-files
SUPABASE_PROJECT_REF=
# Optional temporary override for controlled local/bootstrap password-login tests.
# Keep unset in preview and production once Google OAuth verification is complete.
ALLOW_TRANSITIONAL_PASSWORD_LOGIN=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin

# File analysis embedding backfill (approval-gated)
# Keep disabled unless provider/key/write-audit approval is explicit.
ARCHITECT_FILE_EMBEDDING_PROVIDER=
ARCHITECT_FILE_EMBEDDING_API_KEY=
ARCHITECT_FILE_EMBEDDING_MODEL=text-embedding-3-small
ARCHITECT_FILE_EMBEDDING_DIMENSIONS=1536
ARCHITECT_FILE_EMBEDDING_WRITE_AUDIT=

# Optional server-to-server URL for Verified Legal Evidence API.
# Browser clients must never call this URL directly.
VERIFIED_LEGAL_EVIDENCE_API_URL=http://localhost:4100
# Required when either verified legal bundle or legal search integration is enabled.
# Must match verified-legal-evidence-api VERIFIED_LEGAL_EVIDENCE_API_SECRET.
VERIFIED_LEGAL_EVIDENCE_API_SECRET=
# Optional comma-separated source ids selected by the SaaS server for this environment.
# Leave empty until the evidence service has approved source ids for this SaaS instance.
VERIFIED_LEGAL_EVIDENCE_SOURCE_IDS=
# Optional dedicated legal-search API URL. Leave blank to use VERIFIED_LEGAL_EVIDENCE_API_URL
# only when VERIFIED_LEGAL_SEARCH_ENABLED=1.
VERIFIED_LEGAL_SEARCH_API_URL=
VERIFIED_LEGAL_SEARCH_ENABLED=
# Optional server-only legal batch audit settings for admin status surfaces.
LEGAL_BATCH_AUDIT_REPORT_PATH=
LEGAL_CHANGE_MONITOR_REPORT_PATH=
LEGAL_CHANGE_MONITOR_SECRET=

# Optional Firestore development mode
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
